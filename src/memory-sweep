            self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE,
                                   transition_duration=150)
            self.stack.add_named(self._overview(), "overview")
            self.stack.add_named(self._apps(), "apps")
            self.stack.add_named(self._files(), "files")
            self.stack.add_named(self._settings(), "settings")
            self.stack.add_named(self._about(), "about")
            self.toasts = Adw.ToastOverlay(child=self.stack)

            self.tabs = Adw.ToggleGroup(valign=CENTER)
            for name, title, _ in PAGES:
                if name in TABS:
                    self.tabs.add(Adw.Toggle(name=name, label=title))
            self.tabs.connect("notify::active-name",
                              lambda *_: self.syncing or self.show_page(self.tabs.get_active_name()))
            self.header_title = Adw.WindowTitle()
            self.header = Adw.HeaderBar(title_widget=self.tabs)
            self.sidebar_btn = Gtk.ToggleButton(icon_name="sidebar-show-symbolic", tooltip_text="Sidebar",
                                                visible=False)
            self.header.pack_start(self.sidebar_btn)
            content = Adw.ToolbarView(content=self.toasts)
            content.add_top_bar(self.header)

            self.nav = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
            self.nav.add_css_class("ms-nav")
            self.nav_rows = {}
            for name, title, icon in PAGES:
                row = self._nav_row(title, icon)
                row.name = name
                self.nav.append(row)
                self.nav_rows[name] = row
            self.nav.connect("row-selected", lambda _l, r: r and not self.syncing and self.show_page(r.name))
            brand = Gtk.Box(spacing=10)
            brand.append(Gtk.Image(icon_name=APP_ID, pixel_size=28))
            brand.append(label(APP_NAME, "ms-brand"))
            side_header = Adw.HeaderBar(title_widget=brand, show_end_title_buttons=False)
            side = Gtk.Box(orientation=V, margin_top=8, margin_bottom=14, margin_start=12, margin_end=12)
            side.append(self.nav)
            side.append(Gtk.Box(vexpand=True))
            side.append(label(f"Version {VERSION}", "ms-dim", "ms-small", margin_start=12))
            side_view = Adw.ToolbarView(content=side)
            side_view.add_top_bar(side_header)

            self.split = Adw.OverlaySplitView(sidebar=side_view, content=content,
                                              min_sidebar_width=220, max_sidebar_width=250)
            self.split.bind_property("show-sidebar", self.sidebar_btn, "active",
                                           GObject.BindingFlags.BIDIRECTIONAL | GObject.BindingFlags.SYNC_CREATE)
            self.set_content(self.split)

            # Below 1400 sp the Memory Optimization form stacks, below 1200 sp the other two-column
            # parts do too, and below 900 sp the sidebar folds away. Only the last matching
            # breakpoint applies, so each one repeats the setters of the wider ones.
            large = Adw.Breakpoint.new(Adw.BreakpointCondition.parse("max-width: 1400sp"))
            medium = Adw.Breakpoint.new(Adw.BreakpointCondition.parse("max-width: 1200sp"))
            small = Adw.Breakpoint.new(Adw.BreakpointCondition.parse("max-width: 900sp"))
            for bp, setters in ((large, self.narrow_large), (medium, self.narrow_large + self.narrow),
                                (small, self.narrow_large + self.narrow)):
                for widget, prop, value in setters:
                    bp.add_setter(widget, prop, value)
                self.add_breakpoint(bp)
            small.add_setter(self.split, "collapsed", True)
            small.add_setter(self.sidebar_btn, "visible", True)

            self.refresh()
            self._sample()
            self._restart_timer()
            GLib.timeout_add_seconds(SAMPLE_SECONDS, self._sample)
            self.show_page(page or self.settings["start_page"])

        # ---- building blocks

        def _nav_row(self, title, icon):
            row = Gtk.ListBoxRow()
            b = Gtk.Box(spacing=12)
            b.append(Gtk.Image(icon_name=icon))
            b.append(Gtk.Label(label=title, xalign=0))
            row.set_child(b)
            return row

        def _page(self, title, subtitle, *extra):
            """A scrolled page with a big title; returns (page, body)."""
            body = Gtk.Box(orientation=V, spacing=22, margin_top=8, margin_bottom=28,
                           margin_start=28, margin_end=28)
            head = Gtk.Box(spacing=16)
            names = Gtk.Box(orientation=V, spacing=4, hexpand=True, valign=CENTER)
            names.append(label(title, "ms-h1"))
