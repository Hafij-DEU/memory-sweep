        @staticmethod
        def _parent(folder):
            if not folder or folder in FILE_ROOTS:
                return None
            return os.path.dirname(folder)

        def open_folder(self, folder):
            self.folder = folder
            self.files_loaded = True
            self.folder_label.set_label(folder or "All RAM folders: " + ", ".join(FILE_ROOTS))
            self.up_btn.set_sensitive(folder is not None)
            self.files_spinner.set_visible(True)

            def work():
                try:
                    items = list_items(folder)
                except OSError:
                    items = []
                GLib.idle_add(show, items)

            def show(items):
                if self.folder != folder:
                    return False
                self.files_spinner.set_visible(False)
                self._show_items(folder, items)
                return False

            threading.Thread(target=work, daemon=True).start()

        def _show_items(self, folder, items):
            self.file_list.remove_all()
            total = sum(i.size for i in items)
            if folder:
                self.files_info.set_label(f"{fmt_size(total)} in {len(items)} items")
            else:
                mine = sum(i.size for i in items if i.own)
                text = (f"Files here live in RAM, or in swap when RAM runs out. {fmt_size(total)} in total, "
                        f"{fmt_size(mine)} of it yours. Removing them frees that memory right away.")
                for mp, n in hidden_usage(items, ram_mounts()).items():
                    text += (f"\n{fmt_size(n)} of {mp} is not visible as files: running apps keep it "
                             "open (browsers do this) and free it when they quit.")
                self.files_info.set_label(text)
            shown = [i for i in items if folder or i.size >= SMALL_ITEM][:300]
            now = time.time()
            for it in shown:
                row = Adw.ActionRow(title=it.name, use_markup=False, subtitle_lines=2)
                row.add_prefix(Gtk.Image(icon_name="folder-symbolic" if it.is_dir else "text-x-generic-symbolic"))
                parts = []
                if not folder:
                    parts.append(os.path.dirname(it.path))
                if it.note:
                    parts.append(it.note)
                if it.mtime:
                    parts.append(f"changed {fmt_age(now - it.mtime)} ago")
                if it.in_use:
                    parts.append("in use")
                if not it.own:
                    parts.append("not yours")
                row.set_subtitle(" · ".join(parts))
                row.add_suffix(size_label(fmt_size(it.size)))
                if it.own:
                    b = Gtk.Button(icon_name="user-trash-symbolic", tooltip_text="Remove", valign=CENTER)
                    b.add_css_class("flat")
                    b.connect("clicked", lambda *_, i=it: self.confirm_remove(i))
                    row.add_suffix(b)
                if it.is_dir:
                    row.set_activatable(True)
                    row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
                    row.connect("activated", lambda *_, p=it.path: self.open_folder(p))
                self.file_list.append(row)
            if not shown:
                self.file_list.append(Adw.ActionRow(title="Empty", use_markup=False))
            hidden = len(items) - len(shown)
            self.files_hidden.set_label(f"{hidden} small items not shown" if hidden else "")

        def confirm_remove(self, it):
            why = removable(it.path)
            if why:
                self.toasts.add_toast(Adw.Toast(title=why))
                return
            body = f"{fmt_size(it.size)} at {it.path} will be deleted for good."
            if it.in_use:
                body += "\n\nA running program seems to use it. Removing it may break that program."
            elif it.sockets:
                body += f"\n\nIt holds {it.sockets} socket{'s' if it.sockets != 1 else ''}: " \
                        "programs talk through these, and may stop working."
            dlg = Adw.AlertDialog(heading=f"Remove {it.name}?", body=body)
            dlg.add_response("cancel", "Cancel")
            dlg.add_response("remove", "Remove")
            dlg.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
            dlg.set_default_response("cancel")
            dlg.set_close_response("cancel")
            dlg.connect("response", lambda d, r: r == "remove" and self.remove(it))
            dlg.present(self)

        def remove(self, it):
            self.files_spinner.set_visible(True)

            def work():
                try:
                    left = remove(it.path)
                    msg = f"Removed {it.name}, {fmt_size(it.size)} freed" if not left else \
                        f"Removed most of {it.name}; {left} items could not be deleted"
                except OSError as e:
                    msg = f"Could not remove {it.name}: {e.strerror or e}"
                GLib.idle_add(done, msg)

            def done(msg):
                self.toasts.add_toast(Adw.Toast(title=msg))
                self.open_folder(self.folder)
                self.refresh()
                return False

            threading.Thread(target=work, daemon=True).start()

