                               "and zswap so your RAM goes further.", wrap=True))
            texts.append(label(f"Developed by {AUTHOR}", "ms-dim", "ms-small"))
            hero.append(texts)
            more = Gtk.Button(label="Credits and license", valign=CENTER, css_classes=["ms-outline"])
            more.connect("clicked", lambda *_: self.app.activate_action("about", None))
            hero.append(more)
            body.append(hero)
            safety = card(spacing=10, color="green")
            safety.append(card_head("ms-shield-symbolic", "green", "What it never touches", solid=True)[0])
            safety.append(label(
                "It ends only your own processes, never the parts of the desktop session, and checks "
