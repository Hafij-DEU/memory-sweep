            return page

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
            self.settings = load_settings()
            self.palette = PALETTES["dark"]
            self.css = None
            about = Gio.SimpleAction.new("about", None)
            about.connect("activate", self._about)
            self.add_action(about)
            show = Gio.SimpleAction.new("show-page", GLib.VariantType.new("s"))
            show.connect("activate", lambda a, v: self._present(v.get_string()))
            self.add_action(show)

        def do_startup(self):
            Adw.Application.do_startup(self)
            icons = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
            here = os.path.dirname(os.path.realpath(__file__))
            for d in (os.path.join(here, "..", "data", "icons"), "/usr/share/memory-sweep/icons"):
                if os.path.isdir(d):
                    icons.add_search_path(d)
            Adw.StyleManager.get_default().connect("notify::dark", lambda *_: self._load_palette())
            self.apply_theme()
            self.set_accels_for_action("window.close", ["<Control>w", "<Control>q"])

        def apply_theme(self):
            scheme = {"dark": Adw.ColorScheme.FORCE_DARK, "light": Adw.ColorScheme.FORCE_LIGHT}
            Adw.StyleManager.get_default().set_color_scheme(
                scheme.get(self.settings["theme"], Adw.ColorScheme.DEFAULT))
            self._load_palette()

        def _load_palette(self):
            display = Gdk.Display.get_default()
            self.palette = PALETTES["dark" if Adw.StyleManager.get_default().get_dark() else "light"]
            if self.css:
                Gtk.StyleContext.remove_provider_for_display(display, self.css)
            self.css = Gtk.CssProvider()
            self.css.load_from_string(CSS.substitute(self.palette) + color_css())
            Gtk.StyleContext.add_provider_for_display(display, self.css,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            win = self.get_active_window()
            if win:
                win.chart.queue_draw()

        def do_command_line(self, cmdline):
            args = cmdline.get_arguments()[1:]
            self._present(args[args.index("--page") + 1] if "--page" in args[:-1] else None)
            return 0

        def _present(self, want):
            win = self.get_active_window()
            if win is None:
                win = Window(self)
            elif want:
                win.show_page(want)
            if want:
                win.show_page(want)
            win.present()

        def _about(self, *_):
            about = Adw.AboutDialog(
                application_name=APP_NAME, application_icon=APP_ID, version=VERSION,
                developer_name=AUTHOR, developers=[AUTHOR], copyright=f"© 2026 {AUTHOR}",
                license_type=Gtk.License.MIT_X11,
                comments=f"See what fills your RAM, then end it or remove it.\n\nDeveloped by {AUTHOR}.")
            about.add_legal_section("AI statement", None, Gtk.License.CUSTOM, AI_STATEMENT)
            about.present(self.get_active_window())

    return App().run([sys.argv[0]] + (["--page", page] if page else []))


def main(argv):
    if argv[:1] == ["report"]:
        report(as_json="--json" in argv)
        return 0
    if argv[:1] == ["end"] and len(argv) >= 2:
        return end_app(argv[1], force="--force" in argv)
    if argv[:1] == ["end-extra"] and len(argv) >= 2:
        return end_extra(argv[1], force="--force" in argv)
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    if argv[:1] == ["--version"]:
        print(VERSION)
        return 0
    page = argv[argv.index("--page") + 1] if "--page" in argv[:-1] else None
    return run_gui(page)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
