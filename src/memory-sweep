    3: "Not enough free disk space for that swap file",
    4: "Not enough free RAM to take back what is in swap now. Close some apps first",
    5: "Swap files on btrfs need extra steps, so Memory Sweep leaves them alone",
    6: "zram-tools is not installed",
    7: "This kernel has no zswap",
    8: "apt-get failed. Check the internet connection and try again",
}


def swaps():
    """[(device, kind, size_bytes, used_bytes)] from /proc/swaps."""
    res = []
    for line in _read(f"{PROC}/swaps").splitlines()[1:]:
        f = line.split()
        if len(f) >= 4:
            res.append((f[0].replace("\\040", " "), f[1], int(f[2]) * 1024, int(f[3]) * 1024))
    return res


def _number(path, default):
    try:
        return int(_read(path).strip())
    except ValueError:
        return default


def zram_conf():
    """The active KEY=VALUE lines of the zram-tools config."""
    conf = {}
    for line in _read(ZRAM_CONF).splitlines():
        key, eq, value = line.strip().partition("=")
        if eq and key and not key.startswith("#"):
            conf[key] = value.strip().strip("\"'")
    return conf


def _fstab_swap_file():
    for line in _read("/etc/fstab").splitlines():
        f = line.split()
        if len(f) >= 3 and f[2] == "swap" and f[0].startswith("/") and not f[0].startswith("/dev/"):
            return f[0]
    return None


def swap_status():
    """What the Memory Optimization page shows and starts the form from."""
    total = meminfo().get("MemTotal", 0)
    sw = swaps()
    zr = [s for s in sw if "/zram" in s[0]]
    files = [s for s in sw if s[1] == "file"]
    conf = zram_conf()
    zsize = sum(s[2] for s in zr)
    try:
        percent = int(conf.get("PERCENT", ""))
    except ValueError:
        percent = round(zsize * 100 / total) if total and zsize else 0
    path = files[0][0] if files else _fstab_swap_file()
    size = files[0][2] if files else (os.path.getsize(path) if path and os.path.isfile(path) else 0)
    try:
        free = shutil.disk_usage(os.path.dirname(path or "/swap.img")).free
    except OSError:
        free = 0
    zswap = _read(f"{ZSWAP_PARAMS}/enabled").strip()
    stats = zram()
    return {
        "ram": total,
        "tools": os.path.isfile(ZRAM_CONF) and os.access(ZRAMSWAP, os.X_OK),
        "zram_on": bool(zr), "zram_percent": percent,
        "algo": conf.get("ALGO") if conf.get("ALGO") in ALGOS else "lz4",
        "zram_size": zsize, "zram_used": sum(s[3] for s in zr),
        "zram_stored": sum(s for _, s, _ in stats), "zram_ram": sum(r for _, _, r in stats),
        "file": path, "file_size": size, "file_used": files[0][3] if files else 0,
        "file_active": bool(files), "disk_free": free,
        "zswap": None if not zswap else zswap in ("Y", "1"),
        "zswap_compressor": _read(f"{ZSWAP_PARAMS}/compressor").strip(),
        "swappiness": _number(f"{PROC}/sys/vm/swappiness", 60),
        "cache_pressure": _number(f"{PROC}/sys/vm/vfs_cache_pressure", 100),
    }


def swap_form(st):
    """The form values that match the system as it is now."""
    return {
        "tools": None,  # None, "install", "reinstall" or "remove"
        "zram": st["zram_percent"] if st["zram_on"] else 0,
        "algo": st["algo"],
        "file": max(1, round(st["file_size"] / (1 << 30))) if st["file_size"] else 0,
        "zswap": bool(st["zswap"]),
        "swappiness": st["swappiness"],
        "cache_pressure": st["cache_pressure"],
    }


def plan_changes(st, form):
    """Helper arguments that turn the system `st` into what `form` asks for."""
    now = swap_form(st)
    tools = form.get("tools")
    args = [f"tools={tools}"] if tools else []
    has_tools = (st["tools"] or tools in ("install", "reinstall")) and tools != "remove"
    # A fresh zram-tools starts zram at its own size; set the asked one right after.
    if has_tools and (tools == "install" or (form["zram"], form["algo"]) != (now["zram"], now["algo"])):
        args.append(f"zram={form['zram']}:{form['algo']}")
    if form["file"] >= 1 and form["file"] != now["file"]:
        args.append(f"file={form['file']}")
    if st["zswap"] is not None and form["zswap"] != now["zswap"]:
        args.append(f"zswap={int(form['zswap'])}")
    for key in ("swappiness", "cache_pressure"):
        if form[key] != now[key]:
            args.append(f"{key}={form[key]}")
    return args


def describe_change(arg):
    """One helper argument in words."""
    key, _, value = arg.partition("=")
    if key == "tools":
        return {"install": "Install zram-tools", "reinstall": "Reinstall zram-tools",
                "remove": "Remove zram-tools and turn zram off"}[value]
    if key == "zram":
        percent, _, algo = value.partition(":")
        return "Turn zram off" if percent == "0" else f"zram at {percent}% of RAM, packed with {algo}"
    if key == "file":
        return f"Swap file of {value} GB"
    if key == "zswap":
        return "Turn zswap on" if value == "1" else "Turn zswap off"
    if key == "swappiness":
        return f"Swappiness {value}"
    return f"Cache pressure {value}"


def swap_command(args):
    """pkexec command line for the helper. The installed copy has its own polkit
    action; a source checkout runs the copy next to this file through sh."""
    if os.access(SWAP_HELPER, os.X_OK):
        return ["pkexec", SWAP_HELPER, *args]
    here = os.path.join(os.path.dirname(os.path.realpath(__file__)), "memory-sweep-swap")
    return ["pkexec", "/bin/sh", here, *args]


def usage_sample():
    """(RAM total, RAM used, swap file or partition used, zram used) in bytes now; cheap
    enough for every 2 s."""
    m = meminfo()
    total = m.get("MemTotal", 0)
    disk = comp = 0
    for dev, _, _, used in swaps():
        if "/zram" in dev:
            comp += used
        else:
            disk += used
    return total, total - m.get("MemAvailable", 0), disk, comp


# ---------------------------------------------------------------- settings

SETTINGS = {"refresh": 5, "start_page": "overview", "theme": "dark", "notify": True, "notify_at": 90}


def settings_file():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "memory-sweep", "settings.json")


def load_settings():
    s = dict(SETTINGS)
    try:
        with open(settings_file()) as f:
            data = json.load(f)
        s.update({k: v for k, v in data.items() if k in SETTINGS and type(v) is type(SETTINGS[k])})
    except (OSError, ValueError, AttributeError):
        pass
    return s


def save_settings(s):
    path = settings_file()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as f:
        json.dump(s, f, indent=2)
    os.replace(path + ".tmp", path)


# ---------------------------------------------------------------- CLI

def end_app(key, force=False):
    """End every unlocked instance of the app group `key`. Prints JSON; exit 0 = gone,
    1 = some processes still run, 2 = no such app or it is locked."""
    keep = frozenset(self_and_ancestors())
    group = next((g for g in build_groups(scan_procs(), keep) if g.key == key), None)
    if group is None or group.locked:
        print(json.dumps({"key": key, "error": group.locked if group else "No such app is running"}))
        return 2
    instances = [i for i in group.instances if not instance_locked(i, keep)]
    left = stop(instances, force=force, keep=keep)
    print(json.dumps({"key": key, "title": group.title, "freed": sum(i.mem for i in instances),
                      "left": len(left)}))
    return 1 if left else 0


def end_extra(key, force=False):
    """End the extra copies of app `key` (see extra_copies), never the app itself.
    Prints JSON; exit 0 = gone, 1 = some processes still run, 2 = nothing to end."""
    keep = frozenset(self_and_ancestors())
    group = next((g for g in build_groups(scan_procs(), keep) if g.key == key), None)
    extras = [e for e in group.extras if not instance_locked(e, keep)] if group else []
    if not extras:
        why = "No such app is running" if group is None else \
            f"{group.title} runs no extra copy that can be ended"
        print(json.dumps({"key": key, "error": why}))
        return 2
    left = stop(extras, force=force, keep=keep)
    print(json.dumps({"key": key, "title": group.title, "ended": [e.root.pid for e in extras],
                      "freed": sum(e.mem for e in extras), "left": len(left),
                      "note": f"{group.title} may start it again. The lasting fix belongs in "
                              f"{group.title} itself."}))
    return 1 if left else 0


def report(as_json=False):
    snap = Snapshot(self_and_ancestors())
    items = [i for i in list_items() if i.size >= 10 << 20]
    if as_json:
        print(json.dumps({
            "ram": {"total": snap.total, "used": snap.used, "available": snap.available},
            "swap": {"total": snap.swap_total, "used": snap.swap_used},
            "zram": [{"device": d, "stored": s, "ram": r} for d, s, r in snap.zram],
            "ram_folders": [{"path": mp, "used": u, "size": t} for mp, u, t in snap.mounts],
            "apps": [{"key": g.key, "title": g.title, "ram": g.ram, "swap": g.swap,
                      "processes": len(g.procs), "instances": len(g.instances), "locked": g.locked,
                      "extras": [{"pid": e.root.pid, "ram": e.ram, "swap": e.swap,
                                  "processes": len(e.tree), "note": g.extra_note,
                                  "locked": instance_locked(e, snap.keep)} for e in g.extras]}
                     for g in snap.groups if g.mem >= SMALL_GROUP],
            "files": [{"path": i.path, "size": i.size, "mine": i.own, "in_use": i.in_use,
                       "note": i.note} for i in items],
            "tips": [{"kind": k, "text": t, "page": pg, "key": key} for k, t, pg, key in snap.tips()],
        }, indent=2))
        return
    print(f"RAM   {fmt_size(snap.used)} of {fmt_size(snap.total)} used, "
          f"{fmt_size(snap.available)} available")
    print(f"Swap  {fmt_size(snap.swap_used)} of {fmt_size(snap.swap_total)} used")
    for dev, stored, ram in snap.zram:
        print(f"zram  {dev}: {fmt_size(stored)} stored in {fmt_size(ram)} of RAM")
    for mp, used, total in snap.mounts:
        print(f"Files {mp}: {fmt_size(used)} held in RAM")
    print("\nApps")
    for g in snap.groups[:15]:
        n = len(g.instances)
        extra = f", {n} instances" if n > 1 else ""
        n = len(g.procs)
        print(f"  {fmt_size(g.mem):>9}  {g.title} ({n} process{'es' if n != 1 else ''}{extra})")
        for e in g.extras:
            print(f"  {fmt_size(e.mem):>9}    of it: extra copy, PID {e.root.pid} ({g.extra_note}); "
                  f"end it with: memory-sweep end-extra {g.key}")
    hidden = hidden_usage(list_items(), snap.mounts)
    for mp, n in hidden.items():
        print(f"      {mp}: {fmt_size(n)} of it is not visible as files (kept open by running apps)")
    if items:
        print("\nFiles in RAM")
        for i in items[:15]:
            print(f"  {fmt_size(i.size):>9}  {i.path}" + (f"  [{i.note}]" if i.note else ""))
    tips = snap.tips()
    if tips:
        print("\nSuggestions")
        for _, text, _, _ in tips:
            print("  - " + text)


