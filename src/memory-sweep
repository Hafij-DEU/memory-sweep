        def _load_swap(self):
            self.status = swap_status()
            self.form = swap_form(self.status)
            self._fill_form()
            self._fill_status()

        def _fill_form(self):
            f = self.form
            self.syncing = True
            try:
                self.zram_adj.set_value(f["zram"])
                self.algo.set_selected(ALGOS.index(f["algo"]))
                # No swap file yet: 0 keeps "no change" until the slider moves.
                self.file_adj.set_lower(1 if f["file"] else 0)
                self.file_adj.set_value(f["file"])
                self.zswap_sw.set_active(f["zswap"])
                self.swappiness_adj.set_value(f["swappiness"])
                self.cache_adj.set_value(f["cache_pressure"])
            finally:
                self.syncing = False
            self._update_pending()

        def _form_changed(self):
            if self.syncing or self.form is None:
                return
            self.form.update({
                "zram": int(self.zram_adj.get_value()), "algo": ALGOS[self.algo.get_selected()],
                "file": int(self.file_adj.get_value()), "zswap": self.zswap_sw.get_active(),
                "swappiness": int(self.swappiness_adj.get_value()),
                "cache_pressure": int(self.cache_adj.get_value())})
            self._update_pending()

        def _pick_tools(self, action):
            self.form["tools"] = None if self.form["tools"] == action else action
            self._update_pending()

        def _reset_form(self):
            if self.form is None:
                return
            tools = self.form["tools"]
            self.form = dict(DEFAULTS, tools=tools)
            if not self.status["file_size"]:
                self.form["file"] = DEFAULTS["file"]
            self._fill_form()

        def _update_pending(self):
            st, f = self.status, self.form
            self.pending = plan_changes(st, f)
            if self.pending:
                self.pending_label.set_label("Waiting to apply:\n" + "\n".join(
                    "•  " + describe_change(a) for a in self.pending))
            else:
                self.pending_label.set_label("No changes yet. Change a setting, then apply it here.")
            self.apply_btn.set_sensitive(bool(self.pending) and not self.applying)
            installed = st["tools"]
            pill(self.tools_state, "green" if installed else "dim",
                 "✓  zram-tools installed" if installed else "zram-tools not installed")
            self.tool_btns["install"].set_visible(not installed)
            self.tool_btns["reinstall"].set_visible(installed)
            self.tool_btns["remove"].set_visible(installed)
            for action, b in self.tool_btns.items():
                chosen = f["tools"] == action
                b.set_css_classes(["ms-soft", "red" if action == "remove" else "green"] if chosen
                                  else ["ms-outline"])
            usable = (installed or f["tools"] in ("install", "reinstall")) and f["tools"] != "remove"
            for w in self.zram_widgets:
                w.set_sensitive(usable)
            pct = f["zram"]
            ram = st["ram"]
            self.zram_sub.set_label(
                "Install zram-tools first" if not usable else
                "Off. Swap goes straight to disk." if pct == 0 else
                f"Up to {fmt_size(ram * pct // 100)} of swapped memory kept compressed in RAM. "
                "0 turns zram off.")
            if st["file"]:
                where = f"{st['file']}, {fmt_size(st['file_size'])} now" if st["file_size"] else st["file"]
            else:
                where = "No swap file yet; one is made at /swap.img"
            self.file_sub.set_label(f"{where} · {fmt_size(st['disk_free'])} free on disk")
            self.zswap_sw.set_sensitive(st["zswap"] is not None)
            self.zswap_sub.set_label(
                "This kernel has no zswap" if st["zswap"] is None else
                "Compresses pages before they reach the swap file. With zram on it adds little."
                if pct else "Compresses pages in RAM before they reach the swap file.")

        def _fill_status(self):
            st = self.status
            box = self.status_box
            while (child := box.get_first_child()):
                box.remove(child)

            def line(icon, color, title, note, value=None, frac=None, on=None):
                item = Gtk.Box(spacing=12, css_classes=["ms-row"])
                item.append(badge(icon, color if on is not False else "dim", square=True))
                names = Gtk.Box(orientation=V, spacing=2, hexpand=True, valign=CENTER)
                names.append(label(title, "ms-strong"))
                if note:
                    names.append(label(note, "ms-dim", "ms-small", wrap=True))
                item.append(names)
                if frac is not None:
                    end = Gtk.Box(spacing=8, valign=CENTER)
                    pb = bar(color, thin=True)
                    pb.set_size_request(80, -1)
                    pb.set_fraction(max(0, min(1, frac)))
                    end.append(pb)
                    end.append(label(f"{100 * frac:.0f}%", "ms-num", "ms-strong", xalign=1, width_chars=4))
                    item.append(end)
                elif on is not None:
                    item.append(label("●  Active" if on else "Off", "ms-pill", "green" if on else "dim",
                                      valign=CENTER))
                elif value:
                    item.append(label(value, "ms-pill", color, "ms-num", valign=CENTER))
                box.append(item)

            if st["zram_on"]:
                ratio = f", {st['zram_stored'] / st['zram_ram']:.1f}× packed" if st["zram_ram"] else ""
                line("ms-zram-symbolic", "green", "zram",
                     f"{fmt_size(st['zram_used'])} of {fmt_size(st['zram_size'])} · {st['algo']}{ratio}",
                     frac=st["zram_used"] / st["zram_size"] if st["zram_size"] else 0)
            else:
                line("ms-zram-symbolic", "green", "zram", "Not set up", on=False)
            if st["file_active"]:
                line("drive-harddisk-symbolic", "purple", "Swap file",
                     f"{st['file']} · {fmt_size(st['file_used'])} of {fmt_size(st['file_size'])}",
                     frac=st["file_used"] / st["file_size"] if st["file_size"] else 0)
            else:
                line("drive-harddisk-symbolic", "purple", "Swap file", st["file"] or "None", on=False)
            if st["zswap"] is None:
                line("ms-swap-symbolic", "teal", "zswap", "Not in this kernel", on=False)
            else:
                line("ms-swap-symbolic", "teal", "zswap",
                     f"Compressor {st['zswap_compressor']}" if st["zswap"] else "Not in use",
                     on=bool(st["zswap"]))
            line("ms-gauge-symbolic", "orange", "Swappiness", "How eagerly pages go to swap",
                 str(st["swappiness"]))
            line("ms-gauge-symbolic", "pink", "Cache pressure", "How fast name caches are dropped",
                 str(st["cache_pressure"]))

        def _apply_swap(self):
            args = list(self.pending)
            if not args or self.applying:
                return
            try:
                proc = Gio.Subprocess.new(swap_command(args), Gio.SubprocessFlags.STDOUT_PIPE
                                          | Gio.SubprocessFlags.STDERR_PIPE)
            except GLib.Error as e:
                self.toasts.add_toast(Adw.Toast(title=e.message))
                return
            self.applying = True
            self.apply_spinner.set_visible(True)
            self.apply_btn.set_sensitive(False)
            proc.communicate_utf8_async(None, None, self._swap_done, args)

        def _swap_done(self, proc, res, args):
            try:
                _, out, _ = proc.communicate_utf8_finish(res)
            except GLib.Error:
                out = ""
            code = proc.get_exit_status()
            done = [w.split()[1] for w in (out or "").splitlines() if w.startswith("ok ")]
            if code == 0:
                msg = "Changes applied"
            elif code in (126, 127):  # pkexec: no password given
                msg = "Cancelled"
            else:
                msg = SWAP_ERRORS.get(code, f"The change failed (code {code})")
                if done:
                    msg += f". Done before that: {', '.join(done)}"
            self.applying = False
            self.apply_spinner.set_visible(False)
            self.toasts.add_toast(Adw.Toast(title=msg, timeout=6))
            self._load_swap()
            self.refresh()

        # ---- about

        def _about(self):
