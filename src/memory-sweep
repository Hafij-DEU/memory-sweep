        def _apply_overview(self, snap):
            pct = 100 * snap.used / snap.total if snap.total else 0
            if pct >= 90:
                pill(self.health, "red", "● Almost full")
            elif pct >= 75:
                pill(self.health, "orange", "● Busy")
            else:
                pill(self.health, "green", "● Healthy")
            self.updated.set_label(time.strftime("%H:%M:%S", time.localtime(snap.time)))
            self.ram_card.update(f"{pct:.0f}%", pct / 100,
                                 f"{fmt_size(snap.used)} of {fmt_size(snap.total)} in use",
                                 (fmt_size(snap.used), fmt_size(snap.available), fmt_size(snap.total)))
            size, used = snap.swap_parts(zram=False)
            if size:
                devs = [os.path.basename(d) for d, _, _, _ in snap.swaps if "/zram" not in d]
                self.swap_card.update(f"{100 * used / size:.0f}%", used / size, ", ".join(devs),
                                      (fmt_size(used), fmt_size(size - used), fmt_size(size)))
            else:
                self.swap_card.update("Off", 0, "No swap file or partition", ("–", "–", "–"))
            size, used = snap.swap_parts(zram=True)
            stored = sum(s for _, s, _ in snap.zram)
            in_ram = sum(r for _, _, r in snap.zram)
            if size:
                ratio = f"{stored / in_ram:.1f}× compression" if in_ram else "Compressed swap in RAM"
                self.zram_card.update(f"{100 * used / size:.0f}%", used / size, ratio,
                                      (fmt_size(used), fmt_size(in_ram), fmt_size(size)))
            else:
                self.zram_card.update("Off", 0, "Turn it on in Settings", ("–", "–", "–"))
            used = sum(u for _, u, _ in snap.mounts)
            size = sum(t for _, _, t in snap.mounts)
            self.files_card.update(f"{100 * used / size:.0f}%" if size else "–", used / size if size else 0,
                                   " and ".join(mp for mp, _, _ in snap.mounts) or "No RAM folders",
                                   (fmt_size(used), fmt_size(size - used), fmt_size(size)))
            self._show_tips(snap)
            self._show_top(snap)

        def _toggle_tips(self):
            self.all_tips = not self.all_tips
            self.tips_shown = None
            self._show_tips(self.snap)

        def _show_tips(self, snap):
            tips = snap.tips()
            shown = tips if self.all_tips else tips[:3]
            self.tips_count.set_label(str(len(tips)))
            self.tips_count.set_visible(bool(tips))
            self.see_all.set_visible(len(tips) > 3)
            self.see_all.set_label("Show less" if self.all_tips else "See all")
            if shown == self.tips_shown:
                return
            self.tips_shown = shown
            self.tips_box.remove_all()
            for kind, text, page, key in shown:
                self.tips_box.append(self._tip_card(snap, kind, text, page, key))
            if not tips:
                c = card(spacing=12, vertical=False)
                c.append(badge("object-select-symbolic", "green", small=True))
                texts = Gtk.Box(orientation=V, valign=CENTER)
                texts.append(label("Nothing stands out right now", "ms-strong"))
                texts.append(label("Memory use looks healthy.", "ms-dim", "ms-small"))
                c.append(texts)
                self.tips_box.append(c)

        def _tip_card(self, snap, kind, text, page, key):
            color, icon = {"files": ("orange", "folder-symbolic"), "end": ("red", "process-stop-symbolic"),
                           "zram": ("green", "ms-zram-symbolic")}.get(
                kind, ("blue", "preferences-desktop-apps-symbolic"))
            c = card(spacing=12, vertical=False)
            c.append(badge(icon, color, small=True))
            c.append(label(text, wrap=True, hexpand=True, valign=CENTER))
            if kind == "end":
                grp = next(g for g in snap.groups if g.key == key)
                b = Gtk.Button(label="End", valign=CENTER)
                b.add_css_class("destructive-action")
                b.connect("clicked", lambda *_: self.confirm_end(grp, grp.instances))
            else:
                b = Gtk.Button(label="Set up" if kind == "zram" else "Review", valign=CENTER)
                b.connect("clicked", lambda *_: self._review(page, key))
            c.append(b)
            return c

        def _show_top(self, snap):
            self.top_list.remove_all()
            groups = snap.groups[:6]
            biggest = groups[0].mem if groups and groups[0].mem else 1
            for g in groups:
                row = Gtk.ListBoxRow(activatable=True)
                row.key = g.key
                b = Gtk.Box(spacing=12)
                gicon = self.icons.get(g.key)
                img = Gtk.Image.new_from_gicon(gicon) if gicon else \
                    Gtk.Image(icon_name="application-x-executable-symbolic")
                img.set_pixel_size(24)
                b.append(img)
                b.append(label(g.title, hexpand=True, ellipsize=Pango.EllipsizeMode.END))
                b.append(label(str(len(g.procs)), "ms-num", "ms-dim", xalign=1, width_request=72))
                mem = Gtk.Box(spacing=10, width_request=220, hexpand=False)
                pb = bar("blue", thin=True)
                pb.set_hexpand(True)
                pb.set_fraction(g.mem / biggest)
                mem.append(pb)
                mem.append(label(fmt_size(g.mem), "ms-num", xalign=1, width_chars=8))
                b.append(mem)
                row.set_child(b)
                self.top_list.append(row)

        def _sample(self):
            ram, swap, comp = usage_sample()
            self.history.append((time.monotonic(), ram, swap, comp))
            for key, name, v in (("ram", "RAM", ram), ("swap", "Swap", swap), ("zram", "zram", comp)):
                self.legend[key].set_label(f"{name} {v:.0f}%")
            self.chart.queue_draw()
            return True

        def _draw_chart(self, chart, snap, w, h):
            pal = self.app.palette
            span = CHART_SPANS[self.span.get_selected()][0]
            left, right, top, bottom = 42, 10, 8, 24
            pw, ph = w - left - right, h - top - bottom
            if pw <= 0 or ph <= 0:
                return
            font = Pango.FontDescription.from_string("Sans 8")
            dim = rgba(pal["dim"])

            def text(t, x, y, align=0.0):
                layout = chart.create_pango_layout(t)
                layout.set_font_description(font)
                tw, th = layout.get_pixel_size()
                snap.save()
                snap.translate(Graphene.Point().init(x - tw * align, y - th / 2))
                snap.append_layout(layout, dim)
                snap.restore()

            for pct in (0, 25, 50, 75, 100):
                y = round(top + ph * (1 - pct / 100))
                snap.append_color(rgba(pal["border"]), Graphene.Rect().init(left, y, pw, 1))
                text(f"{pct}%", left - 8, y, align=1)
            ago = (lambda s: f"{s} s ago") if span < 120 else (lambda s: f"{s // 60} min ago")
            for frac, t, align in ((0, ago(span), 0), (0.5, ago(span // 2), 0.5), (1, "now", 1)):
                text(t, left + pw * frac, h - 8, align)
            now = time.monotonic()
            pts = [p for p in self.history if now - p[0] <= span + SAMPLE_SECONDS]
            if len(pts) < 2:
                return

            def xy(t, v):
                return left + pw * max(0, 1 - (now - t) / span), top + ph * (1 - min(100, v) / 100)

            stroke = Gsk.Stroke.new(2.2)
            stroke.set_line_join(Gsk.LineJoin.ROUND)
            for idx, color in ((3, COLORS["green"]), (2, COLORS["purple"]), (1, COLORS["blue"])):
                line = Gsk.PathBuilder.new()
                for i, p in enumerate(pts):
                    (line.move_to if i == 0 else line.line_to)(*xy(p[0], p[idx]))
                if idx == 1:  # soft fill under the RAM line
                    area = Gsk.PathBuilder.new()
                    for i, p in enumerate(pts):
                        (area.move_to if i == 0 else area.line_to)(*xy(p[0], p[idx]))
                    area.line_to(xy(pts[-1][0], 0)[0], top + ph)
                    area.line_to(xy(pts[0][0], 0)[0], top + ph)
                    area.close()
                    snap.append_fill(area.to_path(), Gsk.FillRule.WINDING, rgba(color, 0.16))
                snap.append_stroke(line.to_path(), stroke, rgba(color))

        def _review(self, page, key):
            self.show_page(page)
            if key and key in self.group_rows:
                row = self.group_rows[key]
                self.search.set_text("")
                row.set_expanded(True)
                GLib.idle_add(lambda: row.grab_focus() and False)

        # ---- pages and navigation

        def show_page(self, name):
            sub = None
            if name in [n for n, _, _ in SETTING_PAGES]:
                sub, name = name, "settings"
            if name not in self.nav_rows:
                name = "overview"
            self.stack.set_visible_child_name(name)
            self.syncing = True
            try:
                self.nav.select_row(self.nav_rows[name])
                if name in TABS:
                    self.tabs.set_active_name(name)
                    self.header.set_title_widget(self.tabs)
                else:
                    self.header_title.set_title(dict((n, t) for n, t, _ in PAGES)[name])
                    self.header.set_title_widget(self.header_title)
            finally:
                self.syncing = False
            if name == "settings":
                self.show_setting(sub or self.set_stack.get_visible_child_name() or "memory")
            if name == "files" and not self.files_loaded:
                self.open_folder(self.folder)
            if self.split.get_collapsed():
                self.split.set_show_sidebar(False)

        # ---- scanning

        def _restart_timer(self):
            if self.timer:
                GLib.source_remove(self.timer)
            self.timer = GLib.timeout_add_seconds(self.settings["refresh"], self._tick)

        def _tick(self):
            if self.get_visible():
                self.refresh()
                if self.stack.get_visible_child_name() == "settings" and \
                        self.set_stack.get_visible_child_name() == "memory" and not self.applying:
                    self.status = swap_status()
                    self._fill_status()
            return True

        def refresh(self, files=False):
            if files and self.stack.get_visible_child_name() == "files":
                self.open_folder(self.folder)
            if self.scanning:
                return
            self.scanning = True

            def work():
                try:
                    snap = Snapshot(keep)
                except Exception as e:  # keep the timer alive on odd /proc races
                    print("scan failed:", e, file=sys.stderr)
                    snap = None
                GLib.idle_add(self._apply, snap)

            threading.Thread(target=work, daemon=True).start()

        def _apply(self, snap):
            self.scanning = False
            if snap is None:
                return False
            self.snap = snap
            self._apply_overview(snap)
            self._apply_apps(snap)
            self._notify(snap)
            return False

        def _notify(self, snap):
            pct = 100 * snap.used / snap.total if snap.total else 0
            if not self.settings["notify"] or pct < self.settings["notify_at"] \
                    or time.time() - self.last_notified < 600:
                return
            self.last_notified = time.time()
            n = Gio.Notification.new("RAM is almost full")
            body = f"{pct:.0f}% of RAM is in use."
            if snap.groups:
                body += f" {snap.groups[0].title} uses the most: {fmt_size(snap.groups[0].mem)}."
            n.set_body(body)
            n.set_default_action_and_target_value("app.show-page", GLib.Variant("s", "apps"))
            self.app.send_notification("ram-high", n)

        # ---- apps

        def _apps(self):
            self.search = Gtk.SearchEntry(placeholder_text="Search apps", valign=CENTER, width_request=260)
            self.search.connect("search-changed", lambda *_: self.app_list.invalidate_filter())
            page, body = self._page("Apps", "Everything running as you, grouped by app. "
                                    "End what you do not need; unsaved work in it may be lost.",
                                    self.search)
            self.app_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            self.app_list.add_css_class("boxed-list")
            self.app_list.set_sort_func(lambda a, b: (b.mem > a.mem) - (b.mem < a.mem))
            self.app_list.set_filter_func(self._filter_app)
            body.append(self.app_list)
            self.hidden_label = label("", "dim-label", "caption")
            body.append(self.hidden_label)
            return page

        def _filter_app(self, row):
            q = self.search.get_text().strip().lower()
            if q:
                return q in row.search_text
            return row.mem >= SMALL_GROUP

        def _apply_apps(self, snap):
            seen = set()
            for g in snap.groups:
                seen.add(g.key)
                row = self.group_rows.get(g.key)
                if row is None:
                    row = Adw.ExpanderRow(use_markup=False)
                    gicon = self.icons.get(g.key)
                    img = Gtk.Image.new_from_gicon(gicon) if gicon else \
                        Gtk.Image(icon_name="application-x-executable-symbolic")
                    img.set_pixel_size(28)
                    row.add_prefix(img)
                    row.size = size_label()
                    row.add_suffix(row.size)
                    row.end_btn = end_button(lambda r=row: self.confirm_end(r.group, r.group.instances))
                    row.add_suffix(row.end_btn)
                    row.inst_rows = {}
                    row.inst_order = []
                    self.group_rows[g.key] = row
                row.group = g
                row.mem = g.mem
                row.search_text = f"{g.title} {g.key}".lower()
                if row.get_parent() is None:
                    self.app_list.append(row)
                row.set_title(g.title)
                n, ni = len(g.procs), len(g.instances)
                parts = [f"{n} process{'es' if n != 1 else ''}"]
                if ni > 1:
                    parts.append(f"{ni} instances")
                if g.swap >= 10 << 20:
                    parts.append(f"{fmt_size(g.swap)} in swap")
                parts.append(g.locked or g.hint)
                row.set_subtitle(" · ".join(p for p in parts if p))
                row.size.set_label(fmt_size(g.mem))
                busy = all(i.id in self.busy for i in g.instances)
                row.end_btn.set_visible(not g.locked)
                row.end_btn.set_sensitive(not busy)
                row.end_btn.set_label("Ending…" if busy else ("End all" if ni > 1 else "End"))
                self._apply_instances(row, g)
            for key in list(self.group_rows):
                if key not in seen:
                    self.app_list.remove(self.group_rows.pop(key))
            self.app_list.invalidate_sort()
            self.app_list.invalidate_filter()
            small = sum(1 for g in snap.groups if g.mem < SMALL_GROUP)
            self.hidden_label.set_label(f"{small} apps under {fmt_size(SMALL_GROUP)} are hidden; "
                                        "search to find them" if small else "")

        def _apply_instances(self, row, g):
            order = [i.id for i in g.instances]
            if order != row.inst_order:
                for r in row.inst_rows.values():
                    row.remove(r)
                row.inst_rows = {}
                for inst in g.instances:
                    r = Adw.ActionRow(use_markup=False, subtitle_lines=1)
                    r.size = size_label()
                    r.add_suffix(r.size)
                    r.end_btn = end_button(lambda r=r: self.confirm_end(row.group, [r.inst]))
                    r.add_suffix(r.end_btn)
                    row.add_row(r)
                    row.inst_rows[inst.id] = r
                row.inst_order = order
            now = time.time()
            for inst in g.instances:
                r = row.inst_rows[inst.id]
                r.inst = inst
                n = len(inst.procs)
                r.set_title(f"PID {inst.root.pid} · started {fmt_age(now - inst.root.start)} ago"
                            + (f" · {n} processes" if n > 1 else ""))
                cmd = " ".join(inst.root.argv) or inst.root.comm
                r.set_subtitle(cmd if len(cmd) <= 140 else cmd[:139] + "…")
                r.set_tooltip_text(cmd)
                r.size.set_label(fmt_size(inst.mem))
                locked = instance_locked(inst, keep)
                busy = inst.id in self.busy
                r.end_btn.set_visible(not locked)
                r.end_btn.set_sensitive(not busy)
                r.end_btn.set_label("Ending…" if busy else "End")

        def confirm_end(self, group, instances):
            instances = [i for i in instances if not instance_locked(i, keep) and i.id not in self.busy]
            if not instances:
                return
            mem = sum(i.mem for i in instances)
            procs = sum(len(i.tree) for i in instances)
            whole = len(instances) == len(group.instances)
            what = group.title if whole else f"{group.title} (PID {instances[0].root.pid})" \
                if len(instances) == 1 else f"{len(instances)} instances of {group.title}"
            dlg = Adw.AlertDialog(
                heading=f"End {what}?",
                body=f"{procs} process{'es' if procs != 1 else ''} using about {fmt_size(mem)} "
                     "will be asked to quit. Unsaved work in them may be lost.")
            dlg.add_response("cancel", "Cancel")
            dlg.add_response("end", "End")
            dlg.set_response_appearance("end", Adw.ResponseAppearance.DESTRUCTIVE)
            dlg.set_default_response("cancel")
            dlg.set_close_response("cancel")
            dlg.connect("response", lambda d, r: r == "end" and self.end(what, instances, mem))
            dlg.present(self)

        def end(self, what, instances, mem, force=False):
            for i in instances:
                self.busy.add(i.id)
            if self.snap:
                self._apply_apps(self.snap)

            def work():
                left = stop(instances, force=force, keep=keep)
                GLib.idle_add(done, left)

            def done(left):
                for i in instances:
                    self.busy.discard(i.id)
                if left:
                    t = Adw.Toast(title=f"{what} is still running ({len(left)} processes)", timeout=10)
                    t.set_button_label("Force quit")
                    t.connect("button-clicked", lambda *_: self.end(what, instances, mem, force=True))
                else:
                    t = Adw.Toast(title=f"Ended {what}, about {fmt_size(mem)} freed")
                self.toasts.add_toast(t)
                self.refresh()
                return False

            threading.Thread(target=work, daemon=True).start()

