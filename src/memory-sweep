    class AppIcons:
        """Icon of the installed app that matches a group key, if any."""

        def __init__(self):
            self.cache = {}
            self.apps = None

        def get(self, key):
            if key not in self.cache:
                if self.apps is None:
                    self.apps = [a for a in Gio.AppInfo.get_all() if a.get_icon()]
                k = key.lower()
                self.cache[key] = None
                for a in self.apps:
                    aid = (a.get_id() or "").lower().removesuffix(".desktop")
                    exe = os.path.basename(a.get_executable() or "").lower()
                    if k in (aid, exe, aid.rsplit(".", 1)[-1], aid.rsplit("_", 1)[-1]):
                        self.cache[key] = a.get_icon()
                        break
            return self.cache[key]

    class CardBin(Adw.BreakpointBin):
        """A breakpoint bin that is never shorter than its card and does not clip the card's shadow.
        A plain bin's minimum height is only height_request, and a scrolled page hands out minimum
        heights, so the bottom of a taller card was cut off."""

        def __init__(self, **kw):
            super().__init__(**kw)
            self.set_overflow(Gtk.Overflow.VISIBLE)

        def do_measure(self, orientation, for_size):
            mn, nat, mb, nb = Adw.BreakpointBin.do_measure(self, orientation, for_size)
            child = self.get_child()
            if orientation == Gtk.Orientation.VERTICAL and child:
                mn = max(mn, child.measure(orientation, for_size)[0])
                nat = max(nat, mn)
            return mn, nat, mb, nb

    class StatCard(Gtk.Box):
        """Overview card: solid icon, title, value and percent, a bar and up to four detail cells.

        Below COMPACT_WIDTH it switches to a short title, drops " / total" from the value, uses a
        smaller value font and puts the cells in one column, so nothing is cut to "…"."""

        COMPACT_WIDTH = 300

        def __init__(self, title, icon, color, on_click=None, short=None):
            super().__init__(orientation=V, spacing=14)
            self.add_css_class("ms-card")
            self.add_css_class(color)
            self.titles = (title, short or title)
            self.compact = False
            self.data = None
            top = Gtk.Box(spacing=14)
            top.append(badge(icon, color, solid=True, big=True))
            names = Gtk.Box(orientation=V, spacing=2, valign=CENTER, hexpand=True)
            self.title = label(title, "ms-dim", "ms-strong", ellipsize=Pango.EllipsizeMode.END)
            names.append(self.title)
            self.value = label("", "ms-value", ellipsize=Pango.EllipsizeMode.END)
            names.append(self.value)
            top.append(names)
            self.pct = label("", "ms-pct", "ms-tint", color, valign=Gtk.Align.START)
            top.append(self.pct)
            if on_click:
                clickable(self, on_click)
            self.append(top)
            self.bar = bar(color)
            self.append(self.bar)
            self.grid = Gtk.Grid(column_spacing=8, row_spacing=4, column_homogeneous=True)
            self.cells = []
            for i in range(4):
                c = label("", "ms-dim", "ms-small", "ms-num", ellipsize=Pango.EllipsizeMode.END)
                self.cells.append(c)
            self._place_cells()
            self.append(self.grid)

        def bin(self):
            """The card in a bin that switches it to compact below COMPACT_WIDTH of its own width."""
            b = CardBin(child=self, width_request=230, height_request=150)
            bp = Adw.Breakpoint.new(Adw.BreakpointCondition.parse(f"max-width: {self.COMPACT_WIDTH}px"))
            bp.connect("apply", lambda *_: self._set_compact(True))
            bp.connect("unapply", lambda *_: self._set_compact(False))
            b.add_breakpoint(bp)
            return b

        def _set_compact(self, on):
            self.compact = on
            # Changing text inside the breakpoint switch would need another layout pass right now.
            GLib.idle_add(self._apply_mode)

        def _apply_mode(self):
            (self.add_css_class if self.compact else self.remove_css_class)("ms-compact")
            self.title.set_label(self.titles[self.compact])
            self._place_cells()
            if self.data:
                self.update(*self.data)
            return GLib.SOURCE_REMOVE

        def _place_cells(self):
            """Two columns, or one when compact (empty cells then take no room)."""
            for c in self.cells:
                if c.get_parent():
                    self.grid.remove(c)
            for i, c in enumerate(self.cells):
                col, row = (0, i) if self.compact else (i % 2, i // 2)
                c.set_xalign(0 if self.compact else i % 2)
                self.grid.attach(c, col, row, 1, 1)

        def update(self, value, pct, fraction, cells):
            self.data = (value, pct, fraction, cells)
            # "used / total": the total smaller and dimmer; left out when compact (the cells
            # repeat it).
            used, sep_, total = value.partition(" / ")
            self.value.set_markup(GLib.markup_escape_text(used) + (
                f"<span size='72%' alpha='65%'> / {GLib.markup_escape_text(total)}</span>"
                if sep_ and not self.compact else ""))
            self.pct.set_label(pct)
            self.bar.set_fraction(max(0, min(1, fraction)))
            for lbl, v in zip(self.cells, list(cells) + [""] * 4):
                lbl.set_label(v)
                lbl.set_visible(bool(v) or not self.compact)

