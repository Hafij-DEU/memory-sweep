        def show_setting(self, name=None):
            """Scroll the Settings page to one section (or leave it where it is)."""
            if not self.applying:
                self._load_swap()
            section = self.set_sections.get(name)
            if not section:
                return

            def scroll():
                ok, point = section.compute_point(self.set_body, Graphene.Point())
                if ok:
                    self.set_scroll.get_vadjustment().set_value(max(0, point.y - 8))
                return False
            GLib.idle_add(scroll)

