        def _load_swap(self):
            self.status = swap_status()
            self.form = swap_form(self.status)
            self._fill_form()
            self._fill_status()

        def _fill_form(self):
            f = self.form
            self.syncing = True
            try:
                self.zram_adj.set_value(f["zram"])
                self.algo.set_selected(ALGOS.index(f["algo"]))
                # No swap file yet: 0 keeps "no change" until the slider moves.
                self.file_adj.set_lower(1 if f["file"] else 0)
                self.file_adj.set_value(f["file"])
                self.zswap_sw.set_active(f["zswap"])
                self.swappiness_adj.set_value(f["swappiness"])
                self.cache_adj.set_value(f["cache_pressure"])
            finally:
                self.syncing = False
            self._update_pending()

        def _form_changed(self):
            if self.syncing or self.form is None:
                return
            self.form.update({
                "zram": int(self.zram_adj.get_value()), "algo": ALGOS[self.algo.get_selected()],
                "file": int(self.file_adj.get_value()), "zswap": self.zswap_sw.get_active(),
                "swappiness": int(self.swappiness_adj.get_value()),
                "cache_pressure": int(self.cache_adj.get_value())})
            self._update_pending()

        def _pick_tools(self, action):
            self.form["tools"] = None if self.form["tools"] == action else action
            self._update_pending()

        def _reset_form(self):
            if self.form is None:
                return
            tools = self.form["tools"]
            self.form = dict(DEFAULTS, tools=tools)
            if not self.status["file_size"]:
                self.form["file"] = DEFAULTS["file"]
            self._fill_form()

        def _update_pending(self):
            st, f = self.status, self.form
            self.pending = plan_changes(st, f)
            if self.pending:
                self.pending_label.set_label("Waiting to apply:\n" + "\n".join(
                    "•  " + describe_change(a) for a in self.pending))
            else:
                self.pending_label.set_label("No changes yet. Change a setting, then apply it here.")
            self.apply_btn.set_sensitive(bool(self.pending) and not self.applying)
            installed = st["tools"]
            pill(self.tools_state, "green" if installed else "dim",
                 "zram-tools installed" if installed else "zram-tools not installed")
            self.tool_btns["install"].set_visible(not installed)
            self.tool_btns["reinstall"].set_visible(installed)
            self.tool_btns["remove"].set_visible(installed)
            for action, b in self.tool_btns.items():
                chosen = f["tools"] == action
                b.set_css_classes((["destructive-action"] if action == "remove" else ["suggested-action"])
                                  if chosen else [])
            usable = (installed or f["tools"] in ("install", "reinstall")) and f["tools"] != "remove"
            for w in self.zram_widgets:
                w.set_sensitive(usable)
            pct = f["zram"]
            ram = st["ram"]
            self.zram_sub.set_label(
                "Install zram-tools first" if not usable else
                "Off. Swap goes straight to disk." if pct == 0 else
                f"Up to {fmt_size(ram * pct // 100)} of swapped memory kept compressed in RAM. "
                "0 turns zram off.")
            if st["file"]:
                where = f"{st['file']}, {fmt_size(st['file_size'])} now" if st["file_size"] else st["file"]
            else:
                where = "No swap file yet; one is made at /swap.img"
            self.file_sub.set_label(f"{where} · {fmt_size(st['disk_free'])} free on disk")
            self.zswap_sw.set_sensitive(st["zswap"] is not None)
            self.zswap_sub.set_label(
                "This kernel has no zswap" if st["zswap"] is None else
                "Compresses pages before they reach the swap file. With zram on it adds little."
                if pct else "Compresses pages in RAM before they reach the swap file.")

        def _fill_status(self):
            st = self.status
            box = self.status_box
            while (child := box.get_first_child()):
                box.remove(child)

            def line(title, value, color=None, frac=None, note=None):
                item = Gtk.Box(orientation=V, spacing=6)
                top = Gtk.Box()
                top.append(label(title, "ms-strong", hexpand=True))
                v = label(value, "ms-num", xalign=1)
                if color and frac is None:
                    v.set_css_classes(["ms-pill", color])
                top.append(v)
                item.append(top)
                if frac is not None:
                    pb = bar(color, thin=True)
                    pb.set_fraction(max(0, min(1, frac)))
                    item.append(pb)
                if note:
                    item.append(label(note, "ms-dim", "ms-small", wrap=True))
                box.append(item)

            if st["zram_on"]:
                ratio = f", {st['zram_stored'] / st['zram_ram']:.1f}× packed" if st["zram_ram"] else ""
                line("zram", f"{fmt_size(st['zram_size'])} · {st['algo']}", "green",
                     st["zram_used"] / st["zram_size"] if st["zram_size"] else 0,
                     f"{fmt_size(st['zram_used'])} used{ratio}")
            else:
                line("zram", "Off", "dim")
            if st["file_active"]:
                line("Swap file", fmt_size(st["file_size"]), "purple",
                     st["file_used"] / st["file_size"] if st["file_size"] else 0,
                     f"{st['file']} · {fmt_size(st['file_used'])} used")
            else:
                line("Swap file", "Off", "dim", note=st["file"])
            if st["zswap"] is None:
                line("zswap", "Not in kernel", "dim")
            else:
                line("zswap", f"On · {st['zswap_compressor']}" if st["zswap"] else "Off",
                     "green" if st["zswap"] else "dim")
            line("Swappiness", str(st["swappiness"]))
            line("Cache pressure", str(st["cache_pressure"]))

        def _apply_swap(self):
            args = list(self.pending)
            if not args or self.applying:
                return
            try:
                proc = Gio.Subprocess.new(swap_command(args), Gio.SubprocessFlags.STDOUT_PIPE
                                          | Gio.SubprocessFlags.STDERR_PIPE)
            except GLib.Error as e:
                self.toasts.add_toast(Adw.Toast(title=e.message))
                return
            self.applying = True
            self.apply_spinner.set_visible(True)
            self.apply_btn.set_sensitive(False)
            proc.communicate_utf8_async(None, None, self._swap_done, args)

        def _swap_done(self, proc, res, args):
            try:
                _, out, _ = proc.communicate_utf8_finish(res)
            except GLib.Error:
                out = ""
            code = proc.get_exit_status()
            done = [w.split()[1] for w in (out or "").splitlines() if w.startswith("ok ")]
            if code == 0:
                msg = "Changes applied"
            elif code in (126, 127):  # pkexec: no password given
                msg = "Cancelled"
            else:
                msg = SWAP_ERRORS.get(code, f"The change failed (code {code})")
                if done:
                    msg += f". Done before that: {', '.join(done)}"
            self.applying = False
            self.apply_spinner.set_visible(False)
            self.toasts.add_toast(Adw.Toast(title=msg, timeout=6))
            self._load_swap()
            self.refresh()

        # ---- about

        def _about(self):
            page, body = self._page("About", "Who made Memory Sweep, and how.")
            hero = card(spacing=16, vertical=False)
            hero.append(Gtk.Image(icon_name=APP_ID, pixel_size=96))
            texts = Gtk.Box(orientation=V, spacing=4, valign=CENTER, hexpand=True)
            texts.append(label(APP_NAME, "ms-h1"))
            texts.append(label(f"Version {VERSION}", "ms-dim"))
            texts.append(label("See what fills your RAM, then end it or remove it. Set up zram, swap "
                               "and zswap so your RAM goes further.", wrap=True))
            texts.append(label(f"Developed by {AUTHOR}", "ms-dim", "ms-small"))
            hero.append(texts)
            more = Gtk.Button(label="Credits and license", valign=CENTER)
            more.connect("clicked", lambda *_: self.app.activate_action("about", None))
            hero.append(more)
            body.append(hero)
            safety = card(spacing=8)
            safety.append(label("What it never touches", "ms-h2"))
            safety.append(label(
                "It ends only your own processes, never the parts of the desktop session, and checks "
                "each process again just before it signals it. It removes only your own files in /tmp "
                "and /dev/shm. Swap changes run through a small helper that asks for your password and "
                "changes nothing else.", "ms-dim", wrap=True))
            body.append(safety)
            ai = card(spacing=8)
            ai.append(label("AI statement", "ms-h2"))
            ai.append(label(AI_STATEMENT, "ms-dim", wrap=True))
            body.append(ai)
            return page

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
            self.settings = load_settings()
            self.palette = PALETTES["dark"]
            self.css = None
            about = Gio.SimpleAction.new("about", None)
            about.connect("activate", self._about)
            self.add_action(about)
            show = Gio.SimpleAction.new("show-page", GLib.VariantType.new("s"))
            show.connect("activate", lambda a, v: self._present(v.get_string()))
            self.add_action(show)

        def do_startup(self):
            Adw.Application.do_startup(self)
            icons = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
            here = os.path.dirname(os.path.realpath(__file__))
            for d in (os.path.join(here, "..", "data", "icons"), "/usr/share/memory-sweep/icons"):
                if os.path.isdir(d):
                    icons.add_search_path(d)
            Adw.StyleManager.get_default().connect("notify::dark", lambda *_: self._load_palette())
            self.apply_theme()
            self.set_accels_for_action("window.close", ["<Control>w", "<Control>q"])

        def apply_theme(self):
            scheme = {"dark": Adw.ColorScheme.FORCE_DARK, "light": Adw.ColorScheme.FORCE_LIGHT}
            Adw.StyleManager.get_default().set_color_scheme(
                scheme.get(self.settings["theme"], Adw.ColorScheme.DEFAULT))
            self._load_palette()

        def _load_palette(self):
            display = Gdk.Display.get_default()
            self.palette = PALETTES["dark" if Adw.StyleManager.get_default().get_dark() else "light"]
            if self.css:
                Gtk.StyleContext.remove_provider_for_display(display, self.css)
            self.css = Gtk.CssProvider()
            self.css.load_from_string(CSS.substitute(self.palette))
            Gtk.StyleContext.add_provider_for_display(display, self.css,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            win = self.get_active_window()
            if win:
                win.chart.queue_draw()

        def do_command_line(self, cmdline):
            args = cmdline.get_arguments()[1:]
            self._present(args[args.index("--page") + 1] if "--page" in args[:-1] else None)
            return 0

        def _present(self, want):
            win = self.get_active_window()
            if win is None:
                win = Window(self)
            elif want:
                win.show_page(want)
            if want:
                win.show_page(want)
            win.present()

        def _about(self, *_):
            about = Adw.AboutDialog(
                application_name=APP_NAME, application_icon=APP_ID, version=VERSION,
                developer_name=AUTHOR, developers=[AUTHOR], copyright=f"© 2026 {AUTHOR}",
                license_type=Gtk.License.MIT_X11,
                comments=f"See what fills your RAM, then end it or remove it.\n\nDeveloped by {AUTHOR}.")
            about.add_legal_section("AI statement", None, Gtk.License.CUSTOM, AI_STATEMENT)
            about.present(self.get_active_window())

    return App().run([sys.argv[0]] + (["--page", page] if page else []))


def main(argv):
    if argv[:1] == ["report"]:
        report(as_json="--json" in argv)
        return 0
    if argv[:1] == ["end"] and len(argv) >= 2:
        return end_app(argv[1], force="--force" in argv)
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    if argv[:1] == ["--version"]:
        print(VERSION)
        return 0
    page = argv[argv.index("--page") + 1] if "--page" in argv[:-1] else None
    return run_gui(page)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
