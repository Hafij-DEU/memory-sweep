        def _settings(self):
            """Every setting on one page: three small cards on top, Memory Optimization below."""
            page, body = self._page("Settings", "Customize and optimize your system.",
                                    icon="emblem-system-symbolic", color="green")
            self.set_scroll, self.set_body = page, body
            self.set_sections = {"general": self._general(), "appearance": self._appearance(),
                                 "notifications": self._notifications()}
            body.append(self._columns(*self.set_sections.values(), homogeneous=True))
            self.set_sections["memory"] = self._memory(body)
