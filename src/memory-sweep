            names.append(self.page_sub)
            head.append(names)
            for w in extra:
                head.append(w)
            body.append(head)
            return Gtk.ScrolledWindow(child=body, hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True), body

