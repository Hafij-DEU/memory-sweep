        def _apply_overview(self, snap):
            pct = 100 * snap.used / snap.total if snap.total else 0
            color, text = ("red", "Almost full") if pct >= 90 else ("orange", "Busy") if pct >= 75 \
                else ("green", "System running smoothly")
            self.health.set_css_classes(["ms-status", "ms-tint", color])
            self.health.set_label(f"●  {text}")
            self._show_updated()
            self.ram_card.update(f"{fmt_size(snap.used)} / {fmt_size(snap.total)}", f"{pct:.0f}%",
                                 pct / 100, (f"Used: {fmt_size(snap.used)}", f"Total: {fmt_size(snap.total)}",
                                             f"Available: {fmt_size(snap.available)}"))
            size, used = snap.swap_parts(zram=False)
            if size:
                devs = [os.path.basename(d) for d, _, _, _ in snap.swaps if "/zram" not in d]
                self.swap_card.update(f"{fmt_size(used)} / {fmt_size(size)}", f"{100 * used / size:.0f}%",
                                      used / size, (f"Used: {fmt_size(used)}", f"Total: {fmt_size(size)}",
                                                    f"Free: {fmt_size(size - used)}", ", ".join(devs)))
            else:
                self.swap_card.update("Off", "–", 0, ("No swap file or partition",))
            size, used = snap.swap_parts(zram=True)
            stored = sum(s for _, s, _ in snap.zram)
            in_ram = sum(r for _, _, r in snap.zram)
            if size:
                ratio = f"{stored / in_ram:.1f}× packed" if in_ram else "Nothing packed yet"
                self.zram_card.update(f"{fmt_size(used)} / {fmt_size(size)}", f"{100 * used / size:.0f}%",
                                      used / size, (f"Stored: {fmt_size(stored)}", ratio,
                                                    f"In RAM: {fmt_size(in_ram)}", f"Size: {fmt_size(size)}"))
            else:
                self.zram_card.update("Off", "–", 0, ("Turn it on in Settings",))
            used = sum(u for _, u, _ in snap.mounts)
            size = sum(t for _, _, t in snap.mounts)
            self.files_card.update(fmt_size(used), f"{100 * used / size:.0f}%" if size else "–",
                                   used / size if size else 0,
                                   [f"{mp}: {fmt_size(u)}" for mp, u, _ in snap.mounts][:2]
                                   + [f"Room for {fmt_size(size - used)} more"] if size else ("No RAM folders",))
            self._show_tips(snap)
            self._show_top(snap)

        def _show_updated(self):
            if self.snap:
                ago = max(0, round(time.time() - self.snap.time))
                self.updated.set_label(f"Last updated: {ago} s ago")

        def _toggle_tips(self):
            self.all_tips = not self.all_tips
            self.tips_shown = None
            self._show_tips(self.snap)

        def _show_tips(self, snap):
            tips = snap.tips()
            shown = tips if self.all_tips else tips[:4]
            self.tips_count.set_label(str(len(tips)))
            self.tips_count.set_visible(bool(tips))
            self.see_all.set_visible(len(tips) > 4)
            self.see_all.set_label("Show less" if self.all_tips else "See all")
            if shown == self.tips_shown:
                return
            self.tips_shown = shown
            self.tips_box.remove_all()
            self.tips_box.set_max_children_per_line(max(1, min(4, len(shown))))
            for i, (kind, text, page, key) in enumerate(shown):
                self.tips_box.append(self._tip_card(snap, i, kind, text, page, key))
            if not tips:
                c = Gtk.Box(spacing=12, css_classes=["ms-row"])
                c.append(badge("object-select-symbolic", "green", solid=True))
                texts = Gtk.Box(orientation=V, valign=CENTER)
                texts.append(label("Nothing stands out right now", "ms-strong"))
                texts.append(label("Memory use looks healthy.", "ms-dim", "ms-small"))
                c.append(texts)
                self.tips_box.append(c)

        def _tip_card(self, snap, index, kind, text, page, key):
            icon = {"files": "folder-symbolic", "end": "process-stop-symbolic", "extra": "edit-copy-symbolic",
                    "zram": "ms-zram-symbolic"}.get(kind, "view-grid-symbolic")
            color = ("blue", "purple", "green", "orange")[index % 4]
            c = Gtk.Box(orientation=V, spacing=12, css_classes=["ms-row"])
            top = Gtk.Box(spacing=14, vexpand=True)
            top.append(badge(icon, color, solid=True))
            # max_width_chars keeps the natural width small so four tiles fit in a row.
            top.append(label(text, wrap=True, hexpand=True, valign=CENTER, lines=3, max_width_chars=24,
                             ellipsize=Pango.EllipsizeMode.END))
            c.append(top)
            if kind == "end":
                grp = next(g for g in snap.groups if g.key == key)
                b = Gtk.Button(label="End", css_classes=["ms-soft", "red"], margin_start=54)
                b.connect("clicked", lambda *_: self.confirm_end(grp, grp.instances))
            elif kind == "extra":
                grp = next(g for g in snap.groups if g.key == key)
                b = Gtk.Button(label="End extra copy", css_classes=["ms-soft", "red"], margin_start=54)
                b.connect("clicked", lambda *_: self.confirm_extra(grp))
            else:
                b = Gtk.Button(label="Set up" if kind == "zram" else "Review",
                               css_classes=["ms-soft", "green" if kind == "zram" else "blue"], margin_start=54)
                b.connect("clicked", lambda *_: self._review(page, key))
            c.append(b)
            return c

        def _show_top(self, snap):
            self.top_list.remove_all()
            groups = snap.groups[:6]
            biggest = groups[0].mem if groups and groups[0].mem else 1
            for i, g in enumerate(groups):
                row = Gtk.ListBoxRow(activatable=True)
                row.key = g.key
                b = Gtk.Box(spacing=12)
                gicon = self.icons.get(g.key)
                img = Gtk.Image.new_from_gicon(gicon) if gicon else \
                    Gtk.Image(icon_name="application-x-executable-symbolic")
                img.set_pixel_size(24)
                b.append(img)
                b.append(label(g.title, hexpand=True, ellipsize=Pango.EllipsizeMode.END))
                b.append(label(str(len(g.procs)), "ms-num", "ms-dim", xalign=0.5, width_request=80))
                b.append(label(fmt_size(g.mem), "ms-num", "ms-strong", xalign=1, width_request=80))
                pb = bar(("blue", "cyan", "purple", "pink", "orange", "green")[i], thin=True)
                pb.set_size_request(150, -1)
                pb.set_fraction(g.mem / biggest)
                b.append(pb)
                row.set_child(b)
                self.top_list.append(row)

        def _sample(self):
            total, ram, swap, comp = usage_sample()
            self.history.append((time.monotonic(), total, ram, swap, comp))
            for key, name, v in (("ram", "RAM", ram), ("swap", "Swap", swap), ("zram", "zram", comp)):
                self.legend[key].set_markup(f"<b>{name}</b>  <span alpha='70%'>({fmt_size(v)})</span>")
            self._show_updated()
            self.chart.queue_draw()
            return True

        def _draw_chart(self, chart, snap, w, h):
            pal = self.app.palette
            span = CHART_SPANS[self.span.get_selected()][0]
            left, right, top, bottom = 58, 10, 8, 24
            pw, ph = w - left - right, h - top - bottom
            if pw <= 0 or ph <= 0 or not self.history:
                return
            font = Pango.FontDescription.from_string("Sans 8")
            dim = rgba(pal["dim"])
            now = time.monotonic()
            pts = [p for p in self.history if now - p[0] <= span + SAMPLE_SECONDS]
            top_value = max([self.history[-1][1]] + [max(p[2:]) for p in pts]) or 1

            def text(t, x, y, align=0.0):
                layout = chart.create_pango_layout(t)
                layout.set_font_description(font)
                tw, th = layout.get_pixel_size()
                snap.save()
                snap.translate(Graphene.Point().init(x - tw * align, y - th / 2))
                snap.append_layout(layout, dim)
                snap.restore()

            grid = rgba(pal["border"], 0.8)
            for i in range(5):
                y = round(top + ph * (1 - i / 4))
                snap.append_color(grid, Graphene.Rect().init(left, y, pw, 1))
                text(fmt_size(top_value * i / 4), left - 8, y, align=1)
            for i in range(7):
                x = round(left + pw * i / 6)
                snap.append_color(grid, Graphene.Rect().init(x, top, 1, ph))
                s = span - span * i // 6
                t = "Now" if i == 6 else f"{s}s" if span < 120 else f"{s // 60}m"
                text(t, x, h - 8, 0 if i == 0 else 1 if i == 6 else 0.5)
            if len(pts) < 2:
                return

            def xy(t, v):
                return left + pw * max(0, 1 - (now - t) / span), top + ph * (1 - min(top_value, v) / top_value)

            stroke = Gsk.Stroke.new(2.4)
            stroke.set_line_join(Gsk.LineJoin.ROUND)
            for idx, name in ((4, "green"), (3, "purple"), (2, "blue")):
                color = COLORS[name]
                line, area = Gsk.PathBuilder.new(), Gsk.PathBuilder.new()
                for i, p in enumerate(pts):
                    (line.move_to if i == 0 else line.line_to)(*xy(p[0], p[idx]))
                    (area.move_to if i == 0 else area.line_to)(*xy(p[0], p[idx]))
                area.line_to(xy(pts[-1][0], 0)[0], top + ph)
                area.line_to(xy(pts[0][0], 0)[0], top + ph)
                area.close()
                # Gradient fill under each line, strongest at the top.
                snap.push_fill(area.to_path(), Gsk.FillRule.WINDING)
                stops = []
                for offset, alpha in ((0, 0.45 if idx == 2 else 0.30), (1, 0.02)):
                    stop = Gsk.ColorStop()
                    stop.offset = offset
                    stop.color = rgba(color, alpha)
                    stops.append(stop)
                snap.append_linear_gradient(Graphene.Rect().init(left, top, pw, ph),
                                            Graphene.Point().init(0, top), Graphene.Point().init(0, top + ph),
                                            stops)
                snap.pop()
                snap.append_stroke(line.to_path(), stroke, rgba(color))

        def _review(self, page, key):
            self.show_page(page)
            if key and key in self.group_rows:
                row = self.group_rows[key]
                self.search.set_text("")
                row.set_expanded(True)
                GLib.idle_add(lambda: row.grab_focus() and False)

        # ---- pages and navigation

        def show_page(self, name):
            sub = None
            if name in [n for n, *_ in SETTING_PAGES]:
                sub, name = name, "settings"
            if name not in self.nav_rows:
                name = "overview"
            self.stack.set_visible_child_name(name)
            self.syncing = True
            try:
                self.nav.select_row(self.nav_rows[name])
                if name in HEADER_TABS:
                    self.tabs.set_active_name(name)
                    self.header.set_title_widget(self.tabs)
                else:
                    self.header_title.set_title(dict((n, t) for n, t, *_ in PAGES)[name])
                    self.header.set_title_widget(self.header_title)
            finally:
                self.syncing = False
            if name == "settings":
                self.show_setting(sub)
            if name == "files" and not self.files_loaded:
                self.open_folder(self.folder)
            if self.split.get_collapsed():
                self.split.set_show_sidebar(False)

        # ---- scanning

        def _restart_timer(self):
            if self.timer:
                GLib.source_remove(self.timer)
            self.timer = GLib.timeout_add_seconds(self.settings["refresh"], self._tick)

        def _tick(self):
            if self.get_visible():
                self.refresh()
                if self.stack.get_visible_child_name() == "settings" and not self.applying:
                    self.status = swap_status()
                    self._fill_status()
            return True

        def refresh(self, files=False):
            if files and self.stack.get_visible_child_name() == "files":
                self.open_folder(self.folder)
            if self.scanning:
                return
            self.scanning = True

            def work():
                try:
                    snap = Snapshot(keep)
                except Exception as e:  # keep the timer alive on odd /proc races
                    print("scan failed:", e, file=sys.stderr)
                    snap = None
                GLib.idle_add(self._apply, snap)

            threading.Thread(target=work, daemon=True).start()

        def _apply(self, snap):
            self.scanning = False
            if snap is None:
                return False
            self.snap = snap
            self._apply_overview(snap)
            self._apply_apps(snap)
            self._notify(snap)
            return False

        def _notify(self, snap):
            pct = 100 * snap.used / snap.total if snap.total else 0
            if not self.settings["notify"] or pct < self.settings["notify_at"] \
                    or time.time() - self.last_notified < 600:
                return
            self.last_notified = time.time()
            n = Gio.Notification.new("RAM is almost full")
            body = f"{pct:.0f}% of RAM is in use."
            if snap.groups:
                body += f" {snap.groups[0].title} uses the most: {fmt_size(snap.groups[0].mem)}."
            n.set_body(body)
            n.set_default_action_and_target("app.show-page", GLib.Variant("s", "apps"))
            self.app.send_notification("ram-high", n)

        # ---- apps

        def _apps(self):
            self.search = Gtk.SearchEntry(placeholder_text="Search apps", valign=CENTER, width_request=260)
            self.search.connect("search-changed", lambda *_: self.app_list.invalidate_filter())
            page, body = self._page("Apps", "Everything running as you, grouped by app. "
                                    "End what you do not need; unsaved work in it may be lost.",
                                    self.search, icon="view-grid-symbolic", color="purple")
            self.app_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            self.app_list.add_css_class("boxed-list")
            self.app_list.set_sort_func(lambda a, b: (b.mem > a.mem) - (b.mem < a.mem))
            self.app_list.set_filter_func(self._filter_app)
            body.append(self.app_list)
            self.hidden_label = label("", "dim-label", "caption")
            body.append(self.hidden_label)
            return page

        def _filter_app(self, row):
            q = self.search.get_text().strip().lower()
            if q:
                return q in row.search_text
            return row.mem >= SMALL_GROUP

        def _apply_apps(self, snap):
            seen = set()
            for g in snap.groups:
                seen.add(g.key)
                row = self.group_rows.get(g.key)
                if row is None:
                    row = Adw.ExpanderRow(use_markup=False)
                    gicon = self.icons.get(g.key)
                    img = Gtk.Image.new_from_gicon(gicon) if gicon else \
                        Gtk.Image(icon_name="application-x-executable-symbolic")
                    img.set_pixel_size(28)
                    row.add_prefix(img)
                    row.size = size_label()
                    row.add_suffix(row.size)
                    row.end_btn = end_button(lambda r=row: self.confirm_end(r.group, r.group.instances))
                    row.add_suffix(row.end_btn)
                    row.extra_btn = Gtk.Button(valign=CENTER, css_classes=["ms-soft", "orange"])
                    row.extra_btn.connect("clicked", lambda _b, r=row: self.confirm_extra(r.group))
                    row.add_suffix(row.extra_btn)
                    row.inst_rows = {}
                    row.inst_order = []
                    self.group_rows[g.key] = row
                row.group = g
                row.mem = g.mem
                row.search_text = f"{g.title} {g.key}".lower()
                if row.get_parent() is None:
                    self.app_list.append(row)
                row.set_title(g.title)
                n, ni = len(g.procs), len(g.instances)
                parts = [f"{n} process{'es' if n != 1 else ''}"]
                if ni > 1:
                    parts.append(f"{ni} instances")
                if g.swap >= 10 << 20:
                    parts.append(f"{fmt_size(g.swap)} in swap")
                extras = [e for e in g.extras if not instance_locked(e, keep)]
                if extras:
                    parts.append(f"extra copy uses {fmt_size(sum(e.mem for e in extras))}")
                parts.append(g.locked or g.hint)
                row.set_subtitle(" · ".join(p for p in parts if p))
                row.size.set_label(fmt_size(g.mem))
                busy = all(i.id in self.busy for i in g.instances)
                row.end_btn.set_visible(not g.locked)
                row.end_btn.set_sensitive(not busy)
                row.end_btn.set_label("Ending…" if busy else ("End all" if ni > 1 else "End"))
                extra_busy = bool(extras) and all(e.id in self.busy for e in extras)
                row.extra_btn.set_visible(bool(extras))
                row.extra_btn.set_sensitive(not extra_busy and not busy)
                row.extra_btn.set_label("Ending…" if extra_busy else
                                        "End extra copy" if len(extras) <= 1 else "End extra copies")
                row.extra_btn.set_tooltip_text(f"{g.extra_note}. {g.title} keeps running.")
                self._apply_instances(row, g)
            for key in list(self.group_rows):
                if key not in seen:
                    self.app_list.remove(self.group_rows.pop(key))
            self.app_list.invalidate_sort()
            self.app_list.invalidate_filter()
            small = sum(1 for g in snap.groups if g.mem < SMALL_GROUP)
            self.hidden_label.set_label(f"{small} apps under {fmt_size(SMALL_GROUP)} are hidden; "
                                        "search to find them" if small else "")

        def _apply_instances(self, row, g):
            order = [i.id for i in g.instances] + [("extra",) + e.id for e in g.extras]
            if order != row.inst_order:
                for r in row.inst_rows.values():
                    row.remove(r)
                row.inst_rows = {}
                for inst in g.instances:
                    r = Adw.ActionRow(use_markup=False, subtitle_lines=1)
                    r.size = size_label()
                    r.add_suffix(r.size)
                    r.end_btn = end_button(lambda r=r: self.confirm_end(row.group, [r.inst]))
                    r.add_suffix(r.end_btn)
                    row.add_row(r)
                    row.inst_rows[inst.id] = r
                for e in g.extras:
                    r = Adw.ActionRow(use_markup=False, subtitle_lines=2)
                    r.add_prefix(Gtk.Image(icon_name="edit-copy-symbolic", css_classes=["dim-label"]))
                    r.size = size_label()
                    r.add_suffix(r.size)
                    r.end_btn = end_button(lambda r=r: self.confirm_extra(row.group, [r.inst]),
                                           "End copy")
                    r.add_suffix(r.end_btn)
                    row.add_row(r)
                    row.inst_rows[("extra",) + e.id] = r
                row.inst_order = order
            now = time.time()
            for inst in g.instances:
                r = row.inst_rows[inst.id]
                r.inst = inst
                n = len(inst.procs)
                r.set_title(f"PID {inst.root.pid} · started {fmt_age(now - inst.root.start)} ago"
                            + (f" · {n} processes" if n > 1 else ""))
                cmd = " ".join(inst.root.argv) or inst.root.comm
                r.set_subtitle(cmd if len(cmd) <= 140 else cmd[:139] + "…")
                r.set_tooltip_text(cmd)
                r.size.set_label(fmt_size(inst.mem))
                locked = instance_locked(inst, keep)
                busy = inst.id in self.busy
                r.end_btn.set_visible(not locked)
                r.end_btn.set_sensitive(not busy)
                r.end_btn.set_label("Ending…" if busy else "End")
            for e in g.extras:
                r = row.inst_rows[("extra",) + e.id]
                r.inst = e
                r.set_title(f"Extra copy · PID {e.root.pid} · {len(e.tree)} processes")
                r.set_subtitle(f"{g.extra_note}, inside PID {e.root.ppid}. Ending it leaves "
                               f"{g.title} running; {g.title} may start it again.")
                r.set_tooltip_text(" ".join(e.root.argv) or e.root.comm)
                r.size.set_label(fmt_size(e.mem))
                busy = e.id in self.busy
                r.end_btn.set_visible(not instance_locked(e, keep))
                r.end_btn.set_sensitive(not busy)
                r.end_btn.set_label("Ending…" if busy else "End copy")

        def confirm_extra(self, group, extras=None):
            """End the extra copies an app runs as helpers (see extra_copies), not the app."""
            extras = [e for e in (group.extras if extras is None else extras)
                      if not instance_locked(e, keep) and e.id not in self.busy]
            if not extras:
                return
            mem = sum(e.mem for e in extras)
            swap = sum(e.swap for e in extras)
            procs = sum(len(e.tree) for e in extras)
            pids = ", ".join(str(e.root.pid) for e in extras)
            what = (f"the extra copy of {group.title}" if len(extras) == 1
                    else f"{len(extras)} extra copies of {group.title}")
            in_swap = f", {fmt_size(swap)} of it in swap" if swap >= 10 << 20 else ""
            dlg = Adw.AlertDialog(
                heading=f"End {what}?",
                body=f"{group.extra_note} (PID {pids}) is a second {group.title} with its own GPU, "
                     f"network and zygote processes: {procs} process{'es' if procs != 1 else ''} "
                     f"using about {fmt_size(mem)}{in_swap}. {group.title} itself keeps running.\n\n"
                     f"{group.title} may start the copy again after a few seconds. "
                     f"The lasting fix belongs in {group.title} itself.")
            dlg.add_response("cancel", "Cancel")
            dlg.add_response("end", "End copy")
            dlg.set_response_appearance("end", Adw.ResponseAppearance.DESTRUCTIVE)
            dlg.set_default_response("cancel")
            dlg.set_close_response("cancel")
            dlg.connect("response", lambda d, r: r == "end" and self.end(
                what, extras, mem, note=f"{group.title} may start it again"))
            dlg.present(self)

        def confirm_end(self, group, instances):
            instances = [i for i in instances if not instance_locked(i, keep) and i.id not in self.busy]
            if not instances:
                return
            mem = sum(i.mem for i in instances)
            procs = sum(len(i.tree) for i in instances)
            whole = len(instances) == len(group.instances)
            what = group.title if whole else f"{group.title} (PID {instances[0].root.pid})" \
                if len(instances) == 1 else f"{len(instances)} instances of {group.title}"
            dlg = Adw.AlertDialog(
                heading=f"End {what}?",
                body=f"{procs} process{'es' if procs != 1 else ''} using about {fmt_size(mem)} "
                     "will be asked to quit. Unsaved work in them may be lost.")
            dlg.add_response("cancel", "Cancel")
            dlg.add_response("end", "End")
            dlg.set_response_appearance("end", Adw.ResponseAppearance.DESTRUCTIVE)
            dlg.set_default_response("cancel")
            dlg.set_close_response("cancel")
            dlg.connect("response", lambda d, r: r == "end" and self.end(what, instances, mem))
            dlg.present(self)

        def end(self, what, instances, mem, force=False, note=None):
            for i in instances:
                self.busy.add(i.id)
            if self.snap:
                self._apply_apps(self.snap)

            def work():
                left = stop(instances, force=force, keep=keep)
                GLib.idle_add(done, left)

            def done(left):
                for i in instances:
                    self.busy.discard(i.id)
                if left:
                    t = Adw.Toast(title=f"{what} is still running ({len(left)} processes)", timeout=10)
                    t.set_button_label("Force quit")
                    t.connect("button-clicked", lambda *_: self.end(what, instances, mem, True, note))
                else:
                    t = Adw.Toast(title=f"Ended {what}, about {fmt_size(mem)} freed"
                                  + (f". {note}" if note else ""), timeout=8 if note else 5)
                self.toasts.add_toast(t)
                self.refresh()
                return False

            threading.Thread(target=work, daemon=True).start()

        # ---- files

        def _files(self):
            page, body = self._page("Files in RAM", "Files in /tmp and /dev/shm live in RAM. "
                                    "Removing the ones you no longer need frees that memory at once.",
                                    icon="folder-symbolic", color="orange")
            bar_ = Gtk.Box(spacing=8)
            self.up_btn = Gtk.Button(icon_name="go-up-symbolic", tooltip_text="Up one folder")
            self.up_btn.connect("clicked", lambda *_: self.open_folder(self._parent(self.folder)))
            bar_.append(self.up_btn)
            self.folder_label = label("", "heading", hexpand=True, ellipsize=Pango.EllipsizeMode.START,
                                      selectable=True)
            bar_.append(self.folder_label)
            self.files_spinner = Adw.Spinner(visible=False)
            bar_.append(self.files_spinner)
            body.append(bar_)
            self.files_info = label("", "dim-label", wrap=True)
            body.append(self.files_info)
            self.file_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            self.file_list.add_css_class("boxed-list")
            body.append(self.file_list)
            self.files_hidden = label("", "dim-label", "caption")
            body.append(self.files_hidden)
            return page

        @staticmethod
        def _parent(folder):
            if not folder or folder in FILE_ROOTS:
                return None
            return os.path.dirname(folder)

        def open_folder(self, folder):
            self.folder = folder
            self.files_loaded = True
            self.folder_label.set_label(folder or "All RAM folders: " + ", ".join(FILE_ROOTS))
            self.up_btn.set_sensitive(folder is not None)
            self.files_spinner.set_visible(True)

            def work():
                try:
                    items = list_items(folder)
                except OSError:
                    items = []
                GLib.idle_add(show, items)

            def show(items):
                if self.folder != folder:
                    return False
                self.files_spinner.set_visible(False)
                self._show_items(folder, items)
                return False

            threading.Thread(target=work, daemon=True).start()

        def _show_items(self, folder, items):
            self.file_list.remove_all()
            total = sum(i.size for i in items)
            if folder:
                self.files_info.set_label(f"{fmt_size(total)} in {len(items)} items")
            else:
                mine = sum(i.size for i in items if i.own)
                text = (f"Files here live in RAM, or in swap when RAM runs out. {fmt_size(total)} in total, "
                        f"{fmt_size(mine)} of it yours. Removing them frees that memory right away.")
                for mp, n in hidden_usage(items, ram_mounts()).items():
                    text += (f"\n{fmt_size(n)} of {mp} is not visible as files: running apps keep it "
                             "open (browsers do this) and free it when they quit.")
                self.files_info.set_label(text)
            shown = [i for i in items if folder or i.size >= SMALL_ITEM][:300]
            now = time.time()
            for it in shown:
                row = Adw.ActionRow(title=it.name, use_markup=False, subtitle_lines=2)
                row.add_prefix(Gtk.Image(icon_name="folder-symbolic" if it.is_dir else "text-x-generic-symbolic"))
                parts = []
                if not folder:
                    parts.append(os.path.dirname(it.path))
                if it.note:
                    parts.append(it.note)
                if it.mtime:
                    parts.append(f"changed {fmt_age(now - it.mtime)} ago")
                if it.in_use:
                    parts.append("in use")
                if not it.own:
                    parts.append("not yours")
                row.set_subtitle(" · ".join(parts))
                row.add_suffix(size_label(fmt_size(it.size)))
                if it.own:
                    b = Gtk.Button(icon_name="user-trash-symbolic", tooltip_text="Remove", valign=CENTER)
                    b.add_css_class("flat")
                    b.connect("clicked", lambda *_, i=it: self.confirm_remove(i))
                    row.add_suffix(b)
                if it.is_dir:
                    row.set_activatable(True)
                    row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
                    row.connect("activated", lambda *_, p=it.path: self.open_folder(p))
                self.file_list.append(row)
            if not shown:
                self.file_list.append(Adw.ActionRow(title="Empty", use_markup=False))
            hidden = len(items) - len(shown)
            self.files_hidden.set_label(f"{hidden} small items not shown" if hidden else "")

        def confirm_remove(self, it):
            why = removable(it.path)
            if why:
                self.toasts.add_toast(Adw.Toast(title=why))
                return
            body = f"{fmt_size(it.size)} at {it.path} will be deleted for good."
            if it.in_use:
                body += "\n\nA running program seems to use it. Removing it may break that program."
            elif it.sockets:
                body += f"\n\nIt holds {it.sockets} socket{'s' if it.sockets != 1 else ''}: " \
                        "programs talk through these, and may stop working."
            dlg = Adw.AlertDialog(heading=f"Remove {it.name}?", body=body)
            dlg.add_response("cancel", "Cancel")
            dlg.add_response("remove", "Remove")
            dlg.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
            dlg.set_default_response("cancel")
            dlg.set_close_response("cancel")
            dlg.connect("response", lambda d, r: r == "remove" and self.remove(it))
            dlg.present(self)

        def remove(self, it):
            self.files_spinner.set_visible(True)

            def work():
                try:
                    left = remove(it.path)
                    msg = f"Removed {it.name}, {fmt_size(it.size)} freed" if not left else \
                        f"Removed most of {it.name}; {left} items could not be deleted"
                except OSError as e:
                    msg = f"Could not remove {it.name}: {e.strerror or e}"
                GLib.idle_add(done, msg)

            def done(msg):
                self.toasts.add_toast(Adw.Toast(title=msg))
                self.open_folder(self.folder)
                self.refresh()
                return False

            threading.Thread(target=work, daemon=True).start()

