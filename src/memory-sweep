def color_css():
    """The per-colour rules: tinted and solid icon tiles, bars, pills, cards and buttons."""
    rules = []
    for name, c in COLORS.items():
        e = GRADIENT_ENDS[name]
        rules.append(f"""
.ms-icon.{name} {{ background: alpha({c}, 0.18); color: {c}; }}
.ms-icon.solid.{name} {{ background-image: linear-gradient(135deg, {c}, {e}); color: #ffffff;
  box-shadow: 0 6px 16px alpha({c}, 0.35); }}
.ms-tint.{name} {{ color: {c}; }}
progressbar.ms-bar.{name} > trough > progress {{ background-image: linear-gradient(90deg, {c}, {e}); }}
.ms-pill.{name} {{ background: alpha({c}, 0.16); color: {c}; }}
.ms-dot.{name} {{ background: {c}; }}
.ms-card.{name} {{ background-image: linear-gradient(135deg, alpha({c}, 0.20), alpha({e}, 0.03) 60%);
  border-color: alpha({c}, 0.35); }}
button.ms-soft.{name} {{ background: alpha({c}, 0.18); color: {c}; }}
button.ms-soft.{name}:hover {{ background: alpha({c}, 0.30); }}""")
    return "".join(rules)


