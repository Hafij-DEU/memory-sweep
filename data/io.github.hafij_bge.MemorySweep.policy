<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Memory Sweep</vendor>
  <action id="io.github.hafij_bge.MemorySweep.swap">
    <description>Change swap, zram and zswap</description>
    <message>Authentication is required to change swap, zram and zswap</message>
    <icon_name>io.github.hafij_bge.MemorySweep</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/memory-sweep/memory-sweep-swap</annotate>
  </action>
</policyconfig>
